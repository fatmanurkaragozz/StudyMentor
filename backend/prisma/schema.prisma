datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum EducationLevel {
  MIDDLE_SCHOOL   // LGS
  HIGH_SCHOOL     // YKS
  UNIVERSITY      // Vize/Final
  LIFELONG_LEARNER // Kişisel Gelişim & Kariyer / Genel Çalışma
  EXAM_PREP       // Okul/üniversite bağı olmadan bağımsız sınav hazırlığı (AGS/KPSS/ALES/DGS/YDS/YÖKDİL vb.)
}

// Sidebar/ProfilePage'deki Öğrenci↔Gelişim önizleme geçişinin (AppContext.setUserMode) client-side
// karşılığı - Subject.mode kullanıcıya özel derslerin hangi modda eklendiğini işaretlemek için var.
enum UserMode {
  STUDENT
  LIFELONG_LEARNER
}

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RecommendationType {
  STUDY_PRIORITY
  REVISION
  GENERAL
}

enum PriorityLevel {
  YUKSEK
  ORTA
  DUSUK
}

// Hazır ders/konu kataloğu sunulan merkezi sınav türleri (OTHER = tamamen manuel sınav/hedef).
// YOKDIL eski/genel değer - geriye dönük uyumluluk için duruyor, yeni seçim arayüzünde
// yerini YOKDIL_FEN/YOKDIL_SOSYAL/YOKDIL_SAGLIK varyantları aldı.
enum ExamCategory {
  LGS
  TYT
  AYT
  YDT
  KPSS
  KPSS_EGITIM_BILIMLERI
  ALES
  DGS
  YOKDIL
  YOKDIL_FEN
  YOKDIL_SOSYAL
  YOKDIL_SAGLIK
  AGS
  YDS
  OTHER
}

enum DailyTaskStatus {
  PLANNED
  DONE
  SKIPPED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role           @default(STUDENT)
  educationLevel EducationLevel
  grade          Int?           // Kaçıncı sınıf/yıl (LIFELONG_LEARNER/EXAM_PREP için null)
  examCategory   ExamCategory?  // Sadece educationLevel EXAM_PREP ise anlamlı - hangi sınava hazırlandığı
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // E-posta doğrulama
  emailVerified              Boolean   @default(false)
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?

  // Şifremi unuttum
  passwordResetCode      String?
  passwordResetExpiresAt DateTime?

  // İlişkiler
  customSubjects       Subject[]
  studySessions        StudySession[]
  exams                Exam[]
  habits               Habit[]
  journals             Journal[]
  aiRecommendations    AIRecommendation[]
  resourceSuggestions ResourceSuggestion[]
  topicChecks          TopicCheck[]
  scheduleSlots        ScheduleSlot[]
  dailyTasks           DailyTask[]
  topicReminders       TopicReminder[]
  subjectInsights      SubjectInsight[]
}

model Subject {
  id             String          @id @default(uuid())
  name           String
  educationLevel EducationLevel? // Null ise kullanıcıya özel veya genel derstir
  examCategory   ExamCategory?   // Dolu ise KPSS/YÖKDİL/ALES gibi merkezi bir sınav kataloğuna ait genel ders
  userId         String?         // Kullanıcıya özel tanımlandıysa
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           UserMode?       // Sadece kullanıcıya özel (userId dolu) derslerde anlamlı - hangi modda (Öğrenci/Gelişim) eklendiğini işaretler; genel/seed dersler için her zaman null
  createdAt      DateTime        @default(now())

  // İlişkiler
  topics          Topic[]
  studySessions   StudySession[]
  exams           ExamSubject[]
  scheduleSlots   ScheduleSlot[]
  dailyTasks      DailyTask[]
  subjectInsights SubjectInsight[]

  @@unique([name, userId, mode])
}

// Ders/uğraş bazlı, Claude API ile üretilen AI yorumunun önbelleği - "AI Yorumu Al" butonuna
// her basıldığında yeniden ücretli çağrı yapmamak için kullanıcı+ders başına tek satır tutulur.
// Kullanicinin AI yorumuna verdigi tepki - bir sonraki uretimde Gemini'ye
// duzeltici bir not olarak hatirlatilir (bkz. subjectInsight.service.ts).
enum InsightFeedback {
  LIKE
  DISLIKE
}

model SubjectInsight {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  content        String
  feedback       InsightFeedback?
  feedbackReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, subjectId])
}

// Öğrencinin haftalık ders programı - her hafta tekrar eden sabit çizelge (belirli bir tarihe değil, güne bağlı)
model ScheduleSlot {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 1=Pazartesi ... 7=Pazar
  startTime String   // "10:00"
  endTime   String   // "11:30"
  location  String?
  createdAt DateTime @default(now())
}

model Topic {
  id          String      @id @default(uuid())
  name        String
  subjectId   String
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  status      TopicStatus @default(NOT_STARTED)
  lastStudied DateTime?
  nextReview  DateTime?   // Spaced repetition algoritması tarafından belirlenecek tarih
  createdAt   DateTime    @default(now())

  // İlişkiler
  studySessions   StudySession[]
  checks          TopicCheck[]
  recommendations AIRecommendation[]
  dailyTasks      DailyTask[]
  reminders       TopicReminder[]
}

// Kullanıcıya özel tekrarlayan hatırlatma aboneliği - "N günde bir bu konuyu tekrar et"
// önerisini kullanıcı kabul edince oluşur. Topic.nextReview'in aksine (o alan paylaşılan
// Topic satırında duruyor, kullanıcıya özel değil) bu tablo bilerek userId+topicId ile
// kullanıcıya özel tutuluyor.
model TopicReminder {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  intervalDays   Int
  nextReminderAt DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([userId, topicId])
}

// Uygulama içi "mini kontrol" (soru-cevap) etkileşimi - ML servisine gönderilen
// gerçek (uydurulmamış) attempt_count/hint_count/yanıt-süresi verisini üretir.
model TopicCheck {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId            String
  topic              Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  opportunity        Int            // Bu konu için kaçıncı kontrol olduğu
  attemptCount       Int?
  hintCount          Int?
  msFirstResponse    Float?
  overlapTimeMs      Float?
  selfGradedCorrect  Boolean?
  correctProbability Float?
  priority           PriorityLevel?
  startedAt          DateTime       @default(now())
  submittedAt        DateTime?

  @@index([userId, submittedAt])
}

model StudySession {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId         String
  topic           Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  durationMinutes Int
  difficulty      Int        // 1-5 arası zorluk
  productivity    Int        // 1-5 arası verimlilik
  notes           String?
  createdAt       DateTime   @default(now())

  // İlişkiler
  dailyTask       DailyTask?

  @@index([userId, subjectId])
}

model Exam {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String        // Örn: "YKS Deneme-1", "Matematik Vize"
  date         DateTime
  targetScore  Float?
  resultScore  Float?
  examCategory ExamCategory? // Hangi hazır katalogdan oluşturulduğu (KPSS/YÖKDİL/ALES); null/OTHER = tamamen manuel
  createdAt    DateTime      @default(now())

  // İlişkiler
  subjects    ExamSubject[]
}

// Günlük "bugün ne çalışacağım" planı - bir ders/konuyu o güne planlar, tamamlanınca
// gerçek StudySession kaydına bağlanır (Pomodoro zorunlu değildir).
model DailyTask {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  date           DateTime        // Gün bazında tarih (YYYY-MM-DD)
  status         DailyTaskStatus @default(PLANNED)
  studySessionId String?         @unique
  studySession   StudySession?   @relation(fields: [studySessionId], references: [id])
  createdAt      DateTime        @default(now())
}

model ExamSubject {
  id        String  @id @default(uuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  score     Float?  // Bu dersten yapılan net veya alınan puan
}

model Habit {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // Örn: "Kitap okuma", "Spor", "İngilizce çalışma"
  createdAt DateTime @default(now())

  // İlişkiler
  logs      HabitLog[]
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date        DateTime // Gün bazında tarih (YYYY-MM-DD)
  isCompleted Boolean  @default(false)

  @@unique([habitId, date])
}

model Journal {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  mood           String   // Emoji veya mood metni
  sentimentScore Float?   // AI tarafından hesaplanacak duygu analizi skoru (-1 ile +1 arası)
  createdAt      DateTime @default(now())
}

model AIRecommendation {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String?            // Önerinin hangi konudan üretildiği (izlenebilirlik için)
  topic     Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title     String
  content   String
  type      RecommendationType
  priority  PriorityLevel?     // "Kaptan" kisiliginin frontend'de mesaj uretmesi icin ham veri
  isRead    Boolean            @default(false)
  createdAt DateTime           @default(now())
}

// Henüz hiçbir serviste kullanılmıyor - kullanıcıya özel kaynak önerisi özelliği
// için önceden tasarlanmış ama arka ucu hiç yazılmamış (bkz. CLAUDE.md "Known gaps").
model ResourceSuggestion {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   // Örn: "BTK Akademi - Algoritma Eğitimi"
  link        String
  subjectName String
  createdAt   DateTime @default(now())
}
