# Supabase Veritabanı Bağlantı Bilgileri

# 1. Transaction Connection String (Supabase Dashboard > Settings > Database > Connection Pooling > Mode: Transaction - Port 6543)
# Örn: postgres://postgres.[your-project-id]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection String (Supabase Dashboard > Settings > Database > Connection String > Mode: Session - Port 5432)
# Örn: postgres://postgres.[your-project-id]:[your-password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret Anahtarı (Hafta 2'de kullanılacak)
JWT_SECRET="studymentor_super_secret_key_change_me_in_production"
PORT=5000
